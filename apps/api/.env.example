# Database
DATABASE_URL=postgresql+asyncpg://dataproof:dataproof@localhost:5432/dataproof

# Redis (cache / Celery broker)
REDIS_URL=redis://localhost:6379/0

# MinIO (file storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dataproof
MINIO_SECURE=false

# LLM
DEEPSEEK_API_KEY=your-api-key-here

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_URL=http://localhost:5173

# Auth (JWT)
JWT_SECRET_KEY=change-me-in-production

# Stripe (billing)
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From https://dashboard.stripe.com/test/webhooks — create endpoint → /api/v1/billing/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from https://dashboard.stripe.com/test/products — create "Pro" and "Lab" prices
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_LAB=price_...

# Sentry (error tracking)
SENTRY_DSN=https://...
